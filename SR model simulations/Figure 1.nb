Cell[BoxData[{
 RowBox[{
  RowBox[{"polyModelsSteepnessLifespan", ":=", "\[IndentingNewLine]", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "1"}], "]"}], "]"}], "/", "866.3"}], ",", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"4", ",", "1"}], "]"}], "]"}], "/", "6.43"}]}], "}"}], 
          "&"}], "/@", 
         RowBox[{"allSickspans", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"weights", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1.", "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "2"}], "]"}], "]"}], "*", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"4", ",", "2"}], "]"}], "]"}]}], ")"}]}], ")"}], 
          "&"}], "/@", 
         RowBox[{"allSickspans", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"fits", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", "j", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Length", "@", "j"}], "}"}], ",", 
            RowBox[{
             RowBox[{"LinearModelFit", "[", 
              RowBox[{"data", ",", "j", ",", "vars", ",", 
               RowBox[{"IncludeConstantBasis", "->", "False"}], ",", 
               RowBox[{"Weights", "->", "weights"}]}], "]"}], "[", 
             RowBox[{"{", 
              RowBox[{
              "\"\<BestFit\>\"", ",", "\"\<AICc\>\"", ",", "\"\<BIC\>\"", 
