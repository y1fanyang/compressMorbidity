Cell[BoxData[
 RowBox[{
  RowBox[{"SRModelProcess", "[", 
   RowBox[{
   "eta_", ",", " ", "beta_", ",", " ", "kappa_", ",", "epsilon_", ",", " ", 
    RowBox[{"eta0_", ":", "0"}], ",", " ", 
    RowBox[{"t0_", ":", "0"}], ",", " ", 
    RowBox[{"xstartVal_", ":", "1"}]}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VV", "[", "x_", "]"}], " ", "=", 
     RowBox[{
      RowBox[{"eta", " ", "*", "t"}], "-", "  ", 
      RowBox[{
       RowBox[{"UnitStep", "[", "x", "]"}], "*", "beta", "*", 
       RowBox[{"x", "/", 
        RowBox[{"(", 
         RowBox[{"x", "+", "kappa"}], ")"}]}]}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"NOISE", "[", "x_", "]"}], ":=", " ", 
     RowBox[{
      RowBox[{"UnitStep", "[", "x", "]"}], "*", 
      SqrtBox[
       RowBox[{"2", "epsilon"}]]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"proc", " ", "=", " ", 
     RowBox[{"ItoProcess", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"VV", "[", "x", "]"}], " ", "-", " ", 
          RowBox[{"x", "*", 
           RowBox[{"UnitStep", "[", 
            RowBox[{"-", "x"}], "]"}]}]}], ",", " ", 
         RowBox[{"NOISE", "[", "x", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "xstartVal"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", "t0"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
   ")"}]}]], "Input",
 CellChangeTimes->{{3.883369835762759*^9, 3.883369841625201*^9}, {
  3.883372171584793*^9, 3.883372171836521*^9}, {3.883379945901625*^9, 
