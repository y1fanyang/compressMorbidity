Cell[BoxData[
 RowBox[{
  RowBox[{"EventsFromSimulations", "[", 
   RowBox[{"trajectories_", ",", " ", "conditions_", ",", " ", "age1_"}], 
   "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"condlist", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Internal`RealValuedNumericQ", "@", "conditions"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", ">", "conditions"}], "&"}], "}"}], ",", "conditions"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"events", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"deathtimeinds", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"FirstPosition", "[", 
              RowBox[{"#", ",", 
               RowBox[{"_", "?", "cond"}]}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", "trajectories"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"survinds", "=", 
            RowBox[{"Flatten", "[", 
             RowBox[{"Position", "[", 
              RowBox[{"deathtimeinds", ",", "\"\<NotFound\>\""}], "]"}], 
             "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"censorFlags", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#", "==", "\"\<NotFound\>\""}], ",", " ", "1", ",", 
              "0"}], "]"}], "&"}], "/@", "deathtimeinds"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"SurvDist", "=", 
            RowBox[{"SurvivalDistribution", "[", 
             RowBox[{"EventData", "[", 
              RowBox[{
               RowBox[{"deathtimeinds", "/.", 
                RowBox[{"{", 
                 RowBox[{"\"\<NotFound\>\"", "->", "age1"}], "}"}]}], ",", 
               "censorFlags"}], "]"}], "]"}]}], ";"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"SurvEvents", "=", 
          RowBox[{"EventData", "[", 
           RowBox[{
            RowBox[{"deathtimeinds", "/.", 
             RowBox[{"{", 
              RowBox[{"\"\<NotFound\>\"", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Dimensions", "[", "trajectories", "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ")"}]}], "}"}]}], ",", 
            "censorFlags"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "SurvEvents"}], ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"cond", ",", "condlist"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "events"}], "==", "1"}], ",", 
      RowBox[{"events", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "events"}], "]"}]}], 
   "\[IndentingNewLine]", ")"}]}]], "Input",
