             "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"censorFlags", " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#", "==", "\"\<NotFound\>\""}], ",", " ", "1", ",", 
              "0"}], "]"}], "&"}], "/@", "deathtimeinds"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"SurvDist", "=", 
          RowBox[{"EventData", "[", 
           RowBox[{
            RowBox[{"deathtimeinds", "/.", 
             RowBox[{"{", 
              RowBox[{"\"\<NotFound\>\"", "->", "age1"}], "}"}]}], ",", 
            "censorFlags"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "SurvDist"}], ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"cond", ",", "condlist"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "eventDists"}], "==", "1"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"eventDists", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "trajectories"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"eventDists", ",", "trajectories"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", ")"}]}]], "Input",
