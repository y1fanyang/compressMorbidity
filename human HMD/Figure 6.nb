Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<CCompilerDriver`\>\"", "]"}], "\n", 
 RowBox[{"sf", "=", 
  RowBox[{"Compile", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Eta]", ",", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", ",", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Xc", ",", "_Real"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "_Integer"}], "}"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"X", ",", "i"}], "}"}], ",", 
        RowBox[{
         RowBox[{"X", "=", "0.0"}], ";", 
         RowBox[{"i", "=", "0"}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{"Xc", ">", 
           RowBox[{"(", 
            RowBox[{"X", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"#", " ", 
                RowBox[{"UnitStep", "[", "#", "]"}]}], "&"}], "@", 
              RowBox[{"(", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"++", "i"}], ")"}], "\[Eta]"}], " ", "+", 
                RowBox[{
                 RowBox[{"UnitStep", "[", "X", "]"}], 
                 RowBox[{"(", 
                  RowBox[{"X", "-", 
                   RowBox[{"\[Beta]", " ", 
                    FractionBox["X", 
                    RowBox[{"k", "+", "X"}]]}], "+", 
                   RowBox[{
                    SqrtBox[
                    RowBox[{"2", " ", "\[Epsilon]"}]], 
                    RowBox[{"RandomReal", "[", 
                    RowBox[{"NormalDistribution", "[", 
                    RowBox[{"0", ",", "1."}], "]"}], "]"}]}]}], ")"}]}]}], 
               ")"}]}]}], ")"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"N", "@", "i"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
      "n"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"CompilationTarget", "->", "\"\<C\>\""}], ",", 
    RowBox[{"Parallelization", "->", "True"}], ",", 
    RowBox[{"RuntimeOptions", "->", "\"\<Speed\>\""}]}], "]"}]}]}], "Input",
