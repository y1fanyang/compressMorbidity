Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"correlatedNormSum", "[", 
    RowBox[{"mu_", ",", " ", "cov_", ",", " ", "ws_"}], "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"Length", "@", "mu"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"std", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"Dot", "[", 
         RowBox[{
          RowBox[{"mu", "^", "2"}], ",", 
          RowBox[{"ws", "^", "2"}]}], "]"}], "+", 
        RowBox[{"2", "*", 
         RowBox[{"Total", "@", 
          RowBox[{"Flatten", "@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ws", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "*", 
                RowBox[{"ws", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "*", 
                RowBox[{"cov", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", 
                 RowBox[{"Range", "[", 
                  RowBox[{
                   RowBox[{"i", "+", "1"}], ",", "n"}], "]"}]}], "}"}]}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}]}]}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Around", "[", 
      RowBox[{
       RowBox[{"Dot", "[", 
        RowBox[{"mu", ",", "ws"}], "]"}], ",", "std"}], "]"}]}], 
    "\[IndentingNewLine]", ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vectorAroundLog", "[", 
   RowBox[{"mu_", ",", "cov_"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Length", "@", "mu"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"varLog", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Mean", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"cov", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"mu", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "*", 
               RowBox[{"mu", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}], ",", 
            RowBox[{
             RowBox[{"cov", "[", 
              RowBox[{"[", 
               RowBox[{"j", ",", "i"}], "]"}], "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"mu", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "*", 
               RowBox[{"mu", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}]}], "}"}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"VectorAround", "[", 
     RowBox[{
      RowBox[{"Log", "@", "mu"}], ",", "varLog"}], "]"}]}], 
   "\[IndentingNewLine]", ")"}]}]}], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"a9d8ee72-b56b-469b-b8a1-6c17a518048a"],

