        RowBox[{"(", "2023", ")"}], "."}]}]}], "\[IndentingNewLine]", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"shortN", "=", 
      RowBox[{"Min", "[", 
       RowBox[{"500", ",", " ", 
        RowBox[{"Length", "@", "times"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"d", "=", 
