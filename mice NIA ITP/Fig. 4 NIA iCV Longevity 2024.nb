Cell[BoxData[
 RowBox[{
  RowBox[{"volcanoPlots", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"Join", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Callout", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Log", "@", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1", ",", "j", ",", "1"}], "]"}], 
                   "]"}]}], ",", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "3"}], "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "&"}], "/@", 
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"DeleteCases", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"{", "}"}], ",", "\[Infinity]"}], "]"}], "&"}], "/@", 
                 RowBox[{"Transpose", "@", "LSespval"}]}], ")"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"_", ",", 
                    RowBox[{"Alternatives", "@@", "#"}]}], "}"}], "&"}], "/@", 
                 RowBox[{"Map", "[", 
                  RowBox[{"First", ",", 
                   RowBox[{"Reverse", "@", 
                    RowBox[{"GatherBy", "[", 
                    RowBox[{"sig", ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "&"}]}], "]"}]}], ",", 
                   RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2"}], "}"}]}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Log", "@", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1", ",", "j", ",", "1"}], "]"}], "]"}]}],
                ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "3"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
            
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"DeleteCases", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"{", "}"}], ",", "\[Infinity]"}], "]"}], "&"}], "/@", 
                 RowBox[{"Transpose", "@", "LSespval"}]}], ")"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"_", ",", 
                    RowBox[{"Except", "[", 
                    RowBox[{"Alternatives", "@@", "#"}], "]"}]}], "}"}], 
                  "&"}], "/@", 
                 RowBox[{"Map", "[", 
                  RowBox[{"First", ",", 
                   RowBox[{"Reverse", "@", 
                    RowBox[{"GatherBy", "[", 
                    RowBox[{"sig", ",", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "&"}]}], "]"}]}], ",", 
                   RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
        "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"All", ",", "All"}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", "\[IndentingNewLine]", 
       RowBox[{"ScalingFunctions", "->", 
        RowBox[{"{", 
         RowBox[{"None", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Log", "@", "#"}]}], "&"}], ",", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"-", "#"}], "]"}], "&"}]}], "}"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"\"\<Ln(Relative \>\"", "<>", "#"}], ")"}], "&"}], "/@", 
               RowBox[{"{", 
                RowBox[{"\"\<Longevity)\>\"", ",", "\"\<Steepness)\>\""}], 
                "}"}]}], ")"}], "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", "14"}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<p-value\>\"", ",", " ", "16"}], "]"}]}], "}"}]}], ",",
        "\[IndentingNewLine]", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"12", ",", "Black"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "20"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Mars]", ",", 
              RowBox[{"Darker", "@", "Green"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Venus]", ",", "Orange"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Mars]", ",", 
              RowBox[{"Lighter", "[", 
               RowBox[{"Green", ",", "0.6"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Venus]", ",", 
              RowBox[{"Lighter", "[", 
               RowBox[{"Orange", ",", "0.65"}], "]"}]}], "}"}]}], "}"}]}], 
         ")"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "2"}], "}"}]}], "]"}]}], ";"}]], "Input",
