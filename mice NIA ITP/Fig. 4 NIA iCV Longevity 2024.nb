 RowBox[{
  RowBox[{"meanAround", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Around", "[", 
     RowBox[{
      RowBox[{"Mean", "@", "#"}], ",", 
