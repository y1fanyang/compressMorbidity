Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MultiNormalDistDifferenceTest", "[", 
    RowBox[{"{", 
     RowBox[{"data1_", ",", "data2_"}], "}"}], "]"}], ":=", 
   RowBox[{"Dot", "[", 
    RowBox[{
     RowBox[{"Inverse", "@", 
      RowBox[{"Transpose", "@", 
       RowBox[{"CholeskyDecomposition", "[", 
        RowBox[{
         RowBox[{"Covariance", "@", "data1"}], "+", 
         RowBox[{"Covariance", "@", "data2"}]}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"Mean", "@", "data1"}], "-", 
      RowBox[{"Mean", "@", "data2"}]}]}], "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"MultiNormalDistDifferenceTestPValue", "[", 
     RowBox[{"{", 
      RowBox[{"data1_", ",", "data2_"}], "}"}], "]"}], ":=", 
    RowBox[{"N", "[", 
     RowBox[{"SurvivalFunction", "[", 
      RowBox[{
       RowBox[{"ChiSquareDistribution", "[", 
        RowBox[{"Length", "@", "data1"}], "]"}], ",", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", "^", "2"}], "&"}], ")"}], "/@", 
         RowBox[{"MultiNormalDistDifferenceTest", "[", 
          RowBox[{"{", 
           RowBox[{"data1", ",", "data2"}], "}"}], "]"}]}], "]"}]}], "]"}], 
     "]"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MultiNormalDistDifferenceTestPValue", "[", 
   RowBox[{"{", 
    RowBox[{"data1_", ",", "data2_"}], "}"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zvalues", "=", 
     RowBox[{"MultiNormalDistDifferenceTest", "[", 
      RowBox[{"{", 
       RowBox[{"data1", ",", "data2"}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"N", "[", 
     RowBox[{"SurvivalFunction", "[", 
      RowBox[{
       RowBox[{"ChiSquareDistribution", "[", 
        RowBox[{"Length", "@", "zvalues"}], "]"}], ",", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#", "^", "2"}], "&"}], ")"}], "/@", "zvalues"}], "]"}]}], 
      "]"}], "]"}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NormalDistDifferenceTest", "[", 
   RowBox[{"{", 
    RowBox[{"data1_", ",", "data2_"}], "}"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Mean", "@", "data1"}], "-", 
     RowBox[{"Mean", "@", "data2"}]}], ")"}], "/", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"Variance", "@", "data1"}], "+", 
     RowBox[{"Covariance", "@", "data2"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HostellingTsquared", "[", 
   RowBox[{"{", 
    RowBox[{"data1_", ",", "data2_"}], "}"}], "]"}], ":=", 
  RowBox[{"Dot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Mean", "@", "data1"}], "-", 
     RowBox[{"Mean", "@", "data2"}]}], ",", 
    RowBox[{"Dot", "[", 
     RowBox[{
      RowBox[{"Inverse", "[", 
       RowBox[{
        RowBox[{"Covariance", "@", "data1"}], "+", 
        RowBox[{"Covariance", "@", "data2"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"Mean", "@", "data1"}], "-", 
       RowBox[{"Mean", "@", "data2"}]}]}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HostellingTsquaredTestPValue", "[", 
   RowBox[{"{", 
    RowBox[{"data1_", ",", "data2_"}], "}"}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tsquared", "=", 
     RowBox[{"HostellingTsquared", "[", 
      RowBox[{"{", 
       RowBox[{"data1", ",", "data2"}], "}"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"N", "[", 
     RowBox[{"SurvivalFunction", "[", 
      RowBox[{
       RowBox[{"HotellingTSquareDistribution", "[", 
        RowBox[{"2", ",", "198"}], "]"}], ",", "tsquared"}], "]"}], "]"}]}], 
   ")"}]}]}], "Input",
