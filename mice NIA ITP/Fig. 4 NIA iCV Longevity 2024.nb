Cell[BoxData[
 RowBox[{
  RowBox[{"BetterSmoothDensityHistogram", "[", 
   RowBox[{"data_", ",", "cs_List", ",", "opt___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"d", ",", "domain", ",", "p", ",", "q", ",", "c"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"d", "=", 
      RowBox[{"SmoothKernelDistribution", "[", "data", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"domain", "=", 
      RowBox[{"MinMax", "/@", 
       RowBox[{"(", 
        RowBox[{"data", "\[Transpose]"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"p", "=", 
      RowBox[{"PDF", "[", 
       RowBox[{"d", ",", "data"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"c", "=", 
      RowBox[{"Quantile", "[", 
       RowBox[{"p", ",", 
        RowBox[{"1", "-", "cs"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{"d", ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"domain", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"domain", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"Contours", "->", "c"}], ",", "opt"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.896152299146043*^9, 3.896152366880587*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"1485cf92-de49-48c8-932d-d8070174358c"],

