Cell[BoxData[
 RowBox[{
  RowBox[{"steepnessMWTestRes", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}], "+", 
           FractionBox[
            RowBox[{"MannWhitneyTest", "[", 
             RowBox[{"#", ",", "Automatic", ",", "\"\<TestData\>\""}], "]"}], 
            
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"-", "1"}], "2"], 
               RowBox[{"Times", "@@", 
                RowBox[{"(", 
                 RowBox[{"Length", "/@", "#"}], ")"}]}]}], ",", 
              RowBox[{"1", "/", "132"}]}], "}"}]]}], "&"}], "@", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", ";;", ",", ";;", ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], ",", 
     RowBox[{"GatherBy", "[", 
      RowBox[{"Jdata", ",", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "3"}], "]"}], "]"}], "&"}]}], "]"}], ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]], "Input",
