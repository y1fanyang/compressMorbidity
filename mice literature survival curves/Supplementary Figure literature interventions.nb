                    RowBox[{"#", "!=", "Infinity"}], "&"}]}], "]"}], "]"}], 
                   ",", "1"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"#", ",", "0"}], "}"}]}], "]"}], "&"}], "/@", 
              "deaths"}], ",", 
             RowBox[{"{", 
              RowBox[{"200", ",", 
               RowBox[{"Length", "@", "deaths"}]}], "}"}]}], "]"}]}]}], 
         "\[IndentingNewLine]", ")"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}], "]"}], ",", 
