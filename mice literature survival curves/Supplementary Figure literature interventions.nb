Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"Jdata", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"(", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"deaths", "=", 
           RowBox[{"cohortDeaths", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               FractionBox[
                RowBox[{"Mean", "@", "#"}], 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"StandardDeviation", "@", "#"}]}], "}"}]], "&"}], 
              "@", 
              RowBox[{"SurvivalDistribution", "[", 
               RowBox[{
