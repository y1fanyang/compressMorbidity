                 RowBox[{"(", 
                  RowBox[{"#", "\[Transpose]"}], ")"}]}], ",", 
                RowBox[{"Method", "->", "\"\<KaplanMeier\>\""}]}], "]"}]}], 
             ")"}], "&"}], "/@", 
           RowBox[{"RandomChoice", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"#", "==", "Infinity"}], ",", 
                 RowBox[{"{", 
